{
  "name": "prisma-pglite-bridge",
  "packageManager": "pnpm@11.5.0",
  "version": "1.5.0",
  "description": "In-process PGlite bridge for Prisma — zero-TCP, zero-Docker PostgreSQL",
  "keywords": [
    "prisma",
    "pglite",
    "postgresql",
    "testing",
    "in-memory",
    "database",
    "adapter",
    "bridge",
    "vitest",
    "jest",
    "driver-adapter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drudolf/prisma-pglite-bridge.git"
  },
  "homepage": "https://github.com/drudolf/prisma-pglite-bridge#readme",
  "bugs": "https://github.com/drudolf/prisma-pglite-bridge/issues",
  "author": "drudolf",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest/index.d.mts",
        "default": "./dist/vitest/index.mjs"
      },
      "require": {
        "types": "./dist/vitest/index.d.cts",
        "default": "./dist/vitest/index.cjs"
      }
    },
    "./jest": {
      "import": {
        "types": "./dist/jest/index.d.mts",
        "default": "./dist/jest/index.mjs"
      },
      "require": {
        "types": "./dist/jest/index.d.cts",
        "default": "./dist/jest/index.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "vitest": [
        "./dist/vitest/index.d.cts"
      ],
      "jest": [
        "./dist/jest/index.d.cts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:cli-compat": "vitest run --project cli-compat",
    "test:gc": "vitest run --project gc",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "check": "tsc --noEmit && biome check . && markdownlint-cli2 '**/*.md' '#node_modules' '#.claude' '#vendor' && knip",
    "check:exports": "attw --pack --profile strict",
    "changeset": "changeset",
    "bench": "tsx benchmark/run.ts",
    "build:schema-engine": "tsx scripts/build-schema-engine.ts",
    "prepublishOnly": "pnpm test:unit && pnpm test:gc && pnpm build && pnpm check:exports",
    "prepare": "husky && prisma generate"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.4.0 || ^0.5.0",
    "@jest/globals": "^29.0.0 || ^30.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/config": "^7.0.0",
    "pg": "^8.0.0",
    "vitest": "^3.2.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@jest/globals": {
      "optional": true
    },
    "@prisma/config": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@prisma/driver-adapter-utils": "^7.8.0",
    "@prisma/schema-engine-wasm": "7.8.0-6.3c6e192761c0362d496ed980de936e2f3cebcd3a",
    "postgres-array": "^3.0.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@biomejs/biome": "^2.5.1",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@electric-sql/pglite": "^0.5.3",
    "@jest/globals": "^30.4.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/config": "^7.8.0",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "knip": "^6.23.0",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.22.1",
    "pg": "^8.22.0",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "^7.8.0",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
