{
  "name": "prisma-pglite-bridge",
  "packageManager": "pnpm@11.5.0",
  "version": "1.7.0",
  "description": "In-process PGlite bridge for Prisma — zero-TCP, zero-Docker PostgreSQL",
  "keywords": [
    "prisma",
    "pglite",
    "postgresql",
    "testing",
    "in-memory",
    "database",
    "adapter",
    "bridge",
    "vitest",
    "jest",
    "driver-adapter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drudolf/prisma-pglite-bridge.git"
  },
  "homepage": "https://github.com/drudolf/prisma-pglite-bridge#readme",
  "bugs": "https://github.com/drudolf/prisma-pglite-bridge/issues",
  "author": "drudolf",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./pool": {
      "import": {
        "types": "./dist/entry-pool.d.mts",
        "default": "./dist/entry-pool.mjs"
      },
      "require": {
        "types": "./dist/entry-pool.d.cts",
        "default": "./dist/entry-pool.cjs"
      }
    },
    "./pool/vitest": {
      "import": {
        "types": "./dist/testing/pool-vitest.d.mts",
        "default": "./dist/testing/pool-vitest.mjs"
      },
      "require": {
        "types": "./dist/testing/pool-vitest.d.cts",
        "default": "./dist/testing/pool-vitest.cjs"
      }
    },
    "./pool/jest": {
      "import": {
        "types": "./dist/testing/pool-jest.d.mts",
        "default": "./dist/testing/pool-jest.mjs"
      },
      "require": {
        "types": "./dist/testing/pool-jest.d.cts",
        "default": "./dist/testing/pool-jest.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/testing/vitest.d.mts",
        "default": "./dist/testing/vitest.mjs"
      },
      "require": {
        "types": "./dist/testing/vitest.d.cts",
        "default": "./dist/testing/vitest.cjs"
      }
    },
    "./jest": {
      "import": {
        "types": "./dist/testing/jest.d.mts",
        "default": "./dist/testing/jest.mjs"
      },
      "require": {
        "types": "./dist/testing/jest.d.cts",
        "default": "./dist/testing/jest.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "pool": [
        "./dist/entry-pool.d.cts"
      ],
      "pool/vitest": [
        "./dist/testing/pool-vitest.d.cts"
      ],
      "pool/jest": [
        "./dist/testing/pool-jest.d.cts"
      ],
      "vitest": [
        "./dist/testing/vitest.d.cts"
      ],
      "jest": [
        "./dist/testing/jest.d.cts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:cli-compat": "vitest run --project cli-compat",
    "test:gc": "vitest run --project gc",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "check": "tsc --noEmit && biome check . && markdownlint-cli2 '**/*.md' '#node_modules' '#.claude' '#vendor' && knip",
    "check:exports": "attw --pack --profile strict",
    "check:pool-purity": "tsx scripts/check-pool-purity.ts",
    "changeset": "changeset",
    "bench": "tsx benchmark/run.ts",
    "bench:isolation": "tsx benchmark/isolation-cost.ts",
    "bench:pg-server": "tsx benchmark/pg-server.ts",
    "bench:orm": "tsx benchmark/orm/run.ts",
    "bench:compat": "tsx benchmark/compat/run.ts",
    "bench:statement-cache": "tsx benchmark/statement-cache.ts",
    "bench:lock": "tsx benchmark/lock-admission.ts",
    "build:schema-engine": "tsx scripts/build-schema-engine.ts",
    "prepublishOnly": "pnpm test:unit && pnpm test:gc && pnpm build && pnpm check:exports",
    "prepare": "husky && prisma generate"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.4.0 || ^0.5.0",
    "@jest/globals": "^29.0.0 || ^30.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/config": "^7.0.0",
    "pg": "^8.0.0",
    "vitest": "^3.2.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@jest/globals": {
      "optional": true
    },
    "@prisma/config": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@prisma/driver-adapter-utils": "^7.9.0",
    "@prisma/schema-engine-wasm": "7.8.0-6.3c6e192761c0362d496ed980de936e2f3cebcd3a",
    "postgres-array": "^3.0.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.5",
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@electric-sql/pglite": "^0.5.4",
    "@jest/globals": "^30.4.1",
    "@mikro-orm/core": "^7.1.7",
    "@mikro-orm/pglite": "^7.1.7",
    "@mikro-orm/postgresql": "^7.1.7",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/config": "^7.9.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/pg-cursor": "^2.7.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "embedded-postgres": "18.4.0-beta.17",
    "fast-check": "3.23.2",
    "husky": "^9.1.7",
    "knex": "^3.3.0",
    "knex-pglite": "^0.14.0",
    "knip": "^6.29.0",
    "kysely": "^0.29.3",
    "lint-staged": "^17.2.0",
    "markdownlint-cli2": "^0.23.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.2",
    "pg-copy-streams": "^7.0.0",
    "pg-cursor": "^2.21.0",
    "pg-query-stream": "^4.16.0",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "^7.9.0",
    "tsdown": "^0.22.4",
    "tsx": "^4.23.1",
    "typeorm": "^1.0.0",
    "typeorm-pglite": "^0.3.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
